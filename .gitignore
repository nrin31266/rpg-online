# Reference source stays local; evidence notes are reviewable.
research/*
!research/README.md
!research/notes/
research/notes/*
!research/notes/*.md

# Unity generated/cache/output
/game/Library/
/game/Temp/
/game/Obj/
/game/Logs/
/game/UserSettings/
/game/Builds/
/game/MemoryCaptures/
/game/.vs/
*.csproj
*.sln
*.slnx

# Disposable Unity projects, separate from the future production project
/prototypes/**/Library/
/prototypes/**/Temp/
/prototypes/**/Obj/
/prototypes/**/Logs/
/prototypes/**/UserSettings/
/prototypes/**/Builds/
/prototypes/**/MemoryCaptures/
/prototypes/**/.vs/

# Disposable test/capture output: media and logs stay local only
/prototypes/**/Assets/InitTestScene*
/prototypes/**/PrototypeEvidence/**/*.xml
/prototypes/**/PrototypeEvidence/**/*.log
/prototypes/**/PrototypeEvidence/**/*.mp4
/prototypes/**/PrototypeEvidence/**/*.png
/game/Validation/
/game/PrototypeEvidence/
